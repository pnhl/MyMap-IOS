{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "RNLLAMA_SKIP_POSTINSTALL": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "RNLLAMA_SKIP_POSTINSTALL": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "RNLLAMA_SKIP_POSTINSTALL": "1"
      }
    }
  }
}
